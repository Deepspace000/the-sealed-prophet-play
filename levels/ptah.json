    {"cell": [8, 4], "text": "The north wall rings hollow here."},
    {"cell": [10, 9], "text": "The tower stands alone in the dark. This causeway is the only way across."},
    {"cell": [11, 9], "text": "The tower stands alone in the dark. This causeway is the only way across."},
    {"cell": [30, 50], "text": "The water runs on, down a black tunnel. Cold currents pull away to the east, under the wall."},
    {"cell": [30, 58], "text": "There is a low opening under the water, to the east."},
    {"cell": [10, 61], "text": "A draught seeps from a crack in the west wall."},
    {"cell": [11, 24], "text": "A stair of stone goes down into the dark. You cannot see its end."},
    {"cell": [10, 23], "text": "Here the first gallery begins. Everything in this tower goes down."},
    {"cell": [35, 53], "text": "A small dry room above the water. Someone crawled here to die."},
    {"cell": [3, 80], "text": "The gem of Ptah lies on a plinth in the dark."}
